// Ozen-Sync: параметры интеграции с бухгалтерией.
//
// Свойства общего модуля:
//   Сервер = Истина, ВызовСервера = Ложь, Клиент = Ложь, Глобальный = Ложь,
//   ПовторноеИспользованиеВозвращаемыхЗначений = На время сеанса.
//
// В прототипе значения заданы в коде. В продуктиве их переносят в константы
// расширения (ozs_АдресСервисаБухгалтерии и т.п.) или в регистр настроек,
// а токен доступа — в БезопасноеХранилищеДанных (БСП).

#Область ПрограммныйИнтерфейс

// Параметры подключения к принимающей стороне и политика повторов.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура:
//     * Сервер                  - Строка - хост сервиса бухгалтерии.
//     * Порт                    - Число  - порт.
//     * ЗащищенноеСоединение    - Булево - использовать HTTPS.
//     * АдресРесурса            - Строка - путь эндпоинта приёма документов.
//     * Таймаут                 - Число  - таймаут HTTP-запроса, сек.
//     * ТокенДоступа            - Строка - Bearer-токен (пусто = без авторизации).
//     * РазмерПачки             - Число  - сколько сообщений обрабатывать за запуск.
//     * МаксимумПопыток         - Число  - после стольких HTTP-ошибок сообщение уходит в статус Ошибка.
//     * БазоваяЗадержкаСек      - Число  - задержка перед первым повтором.
//     * МаксимальнаяЗадержкаСек - Число  - потолок экспоненциальной задержки.
//     * ХранитьОтправленныеДней - Число  - сколько дней держать отправленные сообщения в очереди.
//
Функция Параметры() Экспорт

	Параметры = Новый Структура;

	// Подключение
	Параметры.Вставить("Сервер",               "localhost");
	Параметры.Вставить("Порт",                 8000);
	Параметры.Вставить("ЗащищенноеСоединение", Ложь);
	Параметры.Вставить("АдресРесурса",         "/api/v1/accounting/sync");
	Параметры.Вставить("Таймаут",              15);
	Параметры.Вставить("ТокенДоступа",         "");

	// Политика очереди
	Параметры.Вставить("РазмерПачки",             50);
	Параметры.Вставить("МаксимумПопыток",         10);
	Параметры.Вставить("БазоваяЗадержкаСек",      30);
	Параметры.Вставить("МаксимальнаяЗадержкаСек", 3600);
	Параметры.Вставить("ХранитьОтправленныеДней", 30);

	Возврат Новый ФиксированнаяСтруктура(Параметры);

КонецФункции

#КонецОбласти
