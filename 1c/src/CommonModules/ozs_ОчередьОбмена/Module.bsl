// Ozen-Sync: постановка документов в очередь обмена (Transactional Outbox).
//
// Свойства общего модуля:
//   Сервер = Истина, ВнешнееСоединение = Истина, ВызовСервера = Ложь,
//   Клиент = Ложь, Глобальный = Ложь, Привилегированный = Ложь.
//
// Ключевая идея: сообщение пишется в регистр ozs_ОчередьОбменаСБухгалтерией
// ВНУТРИ транзакции записи документа (подписка ПриЗаписи). Поэтому:
//   * документ и сообщение фиксируются атомарно — нельзя провести документ
//     и «потерять» его для бухгалтерии, и нельзя отправить то, что откатилось;
//   * при проведении нет ни одного сетевого вызова — интерфейс не ждёт сеть,
//     а падение бухгалтерии никак не влияет на работу администратора клуба.
// Отправкой занимается регламентное задание (модуль ozs_ОтправкаВБухгалтерию).

#Область ПрограммныйИнтерфейс

// Обработчик подписки на событие ozs_ПоставитьВОчередьОбменаПриЗаписи.
//
// Источник: ДокументОбъект.<документы из ПравилаВыгрузки()>. Событие: ПриЗаписи.
//
// Параметры:
//   Источник - ДокументОбъект - записываемый документ.
//   Отказ    - Булево        - флаг отказа от записи.
//
Процедура ПоставитьВОчередьПриЗаписи(Источник, Отказ) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Правило = ПравилаВыгрузки().Получить(Источник.Метаданные().Имя);
	Если Правило = Неопределено Тогда
		Возврат; // документ подписан, но выгрузка для него не настроена
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина); // у кассира может не быть прав на регистр очереди

	Если Источник.Проведен Тогда
		Операция = "upsert";
	ИначеЕсли ПоследняяОперацияПоОбъекту(Источник.Ссылка) = "upsert" Тогда
		// Документ уже был в бухгалтерии, а теперь распроведён / помечен на удаление.
		Операция = "cancel";
	Иначе
		Возврат; // черновик, бухгалтерии не интересен
	КонецЕсли;

	ИдентификаторСообщения = Новый УникальныйИдентификатор;
	Версия = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пакет = СформироватьПакет(Источник, Правило, Операция, ИдентификаторСообщения, Версия);

	ДобавитьСообщение(ИдентификаторСообщения, Источник.Ссылка, Правило.ТипОбъекта,
		Операция, Версия, СериализоватьВJSON(Пакет));

	// Исключения здесь намеренно НЕ перехватываются: если не удалось записать
	// сообщение в очередь, запись документа должна откатиться целиком.

КонецПроцедуры

// Сериализует структуру в компактную JSON-строку (даты — ISO 8601, локальное время).
//
// Параметры:
//   Данные - Структура, Массив, Соответствие - сериализуемое значение.
//
// Возвращаемое значение:
//   Строка - JSON.
//
Функция СериализоватьВJSON(Данные) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));

	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;

	ЗаписатьJSON(ЗаписьJSON, Данные, Настройки);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ТОЧКА АДАПТАЦИИ.
// Соответствие «имя документа → как его выгружать». Имена документов, реквизитов
// и колонок табличных частей зависят от редакции 1С:Фитнес клуб — сверьте их
// в конфигураторе и добавьте те же документы в состав источников подписки.
//
// Возвращаемое значение:
//   Соответствие - ключ: имя метаданных документа, значение: Структура правила.
//
Функция ПравилаВыгрузки()

	Правила = Новый Соответствие;

	Правила.Вставить("РеализацияТоваровУслуг", НовоеПравило("ПродажаАбонемента",
		"Контрагент", "СуммаДокумента", "Товары",
		"Номенклатура", "Количество", "Цена", "Сумма"));

	Правила.Вставить("ВозвратТоваровОтПокупателя", НовоеПравило("Возврат",
		"Контрагент", "СуммаДокумента", "Товары",
		"Номенклатура", "Количество", "Цена", "Сумма"));

	// У оплаты нет количества и цены: позиция = строка расшифровки платежа.
	Правила.Вставить("ПриходныйКассовыйОрдер", НовоеПравило("Оплата",
		"Контрагент", "СуммаДокумента", "РасшифровкаПлатежа",
		"Договор", "", "", "СуммаПлатежа"));

	Возврат Правила;

КонецФункции

Функция НовоеПравило(ТипОбъекта, РеквизитКлиент, РеквизитСумма, ТабличнаяЧасть,
	КолонкаНаименование, КолонкаКоличество, КолонкаЦена, КолонкаСумма)

	Правило = Новый Структура;
	Правило.Вставить("ТипОбъекта",          ТипОбъекта);
	Правило.Вставить("РеквизитКлиент",      РеквизитКлиент);
	Правило.Вставить("РеквизитСумма",       РеквизитСумма);
	Правило.Вставить("ТабличнаяЧасть",      ТабличнаяЧасть);
	Правило.Вставить("КолонкаНаименование", КолонкаНаименование);
	Правило.Вставить("КолонкаКоличество",   КолонкаКоличество);
	Правило.Вставить("КолонкаЦена",         КолонкаЦена);
	Правило.Вставить("КолонкаСумма",        КолонкаСумма);
	Правило.Вставить("Валюта",              "KZT");

	Возврат Правило;

КонецФункции

// Формирует пакет по контракту API v1 (см. docs/api-contract.md).
// Пакет — полный снимок документа, а не дельта: принимающая сторона делает upsert
// по document_id и отбрасывает устаревшие версии (поле version).
//
Функция СформироватьПакет(Источник, Правило, Операция, ИдентификаторСообщения, Версия)

	Клиент = Источник[Правило.РеквизитКлиент];

	Пакет = Новый Структура;
	Пакет.Вставить("schema_version",  "1.0");
	Пакет.Вставить("message_id",      Строка(ИдентификаторСообщения));
	Пакет.Вставить("source",          "1c-fitness");
	Пакет.Вставить("operation",       Операция);
	Пакет.Вставить("version",         Версия);
	Пакет.Вставить("object_type",     Правило.ТипОбъекта);
	Пакет.Вставить("document_id",     Строка(Источник.Ссылка.УникальныйИдентификатор()));
	Пакет.Вставить("document_number", Источник.Номер);
	Пакет.Вставить("document_date",   Источник.Дата);
	Пакет.Вставить("client_id",       ?(ЗначениеЗаполнено(Клиент), Строка(Клиент.УникальныйИдентификатор()), ""));
	Пакет.Вставить("client_name",     Строка(Клиент));
	Пакет.Вставить("amount",          Источник[Правило.РеквизитСумма]);
	Пакет.Вставить("currency",        Правило.Валюта);

	Позиции = Новый Массив;
	Для Каждого СтрокаТЧ Из Источник[Правило.ТабличнаяЧасть] Цикл

		СуммаСтроки = СтрокаТЧ[Правило.КолонкаСумма];
		Количество  = ?(ПустаяСтрока(Правило.КолонкаКоличество), 1, СтрокаТЧ[Правило.КолонкаКоличество]);
		Цена        = ?(ПустаяСтрока(Правило.КолонкаЦена), СуммаСтроки, СтрокаТЧ[Правило.КолонкаЦена]);

		Позиция = Новый Структура;
		Позиция.Вставить("line",     СтрокаТЧ.НомерСтроки);
		Позиция.Вставить("name",     Строка(СтрокаТЧ[Правило.КолонкаНаименование]));
		Позиция.Вставить("quantity", Количество);
		Позиция.Вставить("price",    Цена);
		Позиция.Вставить("amount",   СуммаСтроки);
		Позиции.Добавить(Позиция);

	КонецЦикла;
	Пакет.Вставить("items", Позиции);

	Возврат Пакет;

КонецФункции

Процедура ДобавитьСообщение(ИдентификаторСообщения, ОбъектСсылка, ТипОбъекта, Операция, Версия, ТелоJSON)

	ТекущаяДата = ТекущаяДатаСеанса();

	МенеджерЗаписи = РегистрыСведений.ozs_ОчередьОбменаСБухгалтерией.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор        = ИдентификаторСообщения;
	МенеджерЗаписи.ОбъектСсылка         = ОбъектСсылка;
	МенеджерЗаписи.ТипОбъекта           = ТипОбъекта;
	МенеджерЗаписи.Операция             = Операция;
	МенеджерЗаписи.Версия               = Версия;
	МенеджерЗаписи.ТелоJSON             = ТелоJSON;
	МенеджерЗаписи.Статус               = Перечисления.ozs_СтатусыОбмена.Ожидает;
	МенеджерЗаписи.КоличествоПопыток    = 0;
	МенеджерЗаписи.ДатаСоздания         = ТекущаяДата;
	МенеджерЗаписи.ДатаСледующейПопытки = ТекущаяДата;

	// Замещение = Ложь: ключ новый, совпадение означает ошибку и должно откатить транзакцию.
	МенеджерЗаписи.Записать(Ложь);

КонецПроцедуры

// Операция ("upsert" / "cancel") последнего сообщения по документу или пустая строка.
//
Функция ПоследняяОперацияПоОбъекту(ОбъектСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.Операция КАК Операция
	|ИЗ
	|	РегистрСведений.ozs_ОчередьОбменаСБухгалтерией КАК Очередь
	|ГДЕ
	|	Очередь.ОбъектСсылка = &ОбъектСсылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.Версия УБЫВ";
	Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Операция, "");

КонецФункции

#КонецОбласти
