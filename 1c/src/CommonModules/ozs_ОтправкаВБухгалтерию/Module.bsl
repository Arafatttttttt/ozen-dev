// Ozen-Sync: доставка сообщений из очереди в бухгалтерию (HTTP-клиент с повторами).
//
// Свойства общего модуля:
//   Сервер = Истина, ВнешнееСоединение = Истина, ВызовСервера = Ложь,
//   Клиент = Ложь, Глобальный = Ложь, Привилегированный = Ложь.
//
// Гарантия доставки: at-least-once. Сообщение может прийти в бухгалтерию повторно
// (например, если ответ 200 потерялся по дороге), поэтому каждый запрос несёт
// заголовок Idempotency-Key = идентификатор сообщения, а приёмник дедуплицирует.
//
// Классификация ответов:
//   2xx                       -> Отправлено.
//   400, 422                  -> Ошибка сразу (битый пакет: повтор ничего не исправит).
//   прочие 4xx, 5xx           -> повтор с экспоненциальной задержкой; после
//                                МаксимумПопыток -> Ошибка (dead letter).
//   сеть недоступна / таймаут -> повтор с задержкой, в Ошибку НЕ переводится
//                                никогда: недоступность сервиса — не вина сообщения.

#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания ozs_ОтправкаОчередиВБухгалтерию (раз в 60 сек).
//
// Платформа не запускает новый экземпляр регламентного задания, пока не завершился
// предыдущий, поэтому одну пачку не обрабатывают два потока одновременно.
//
Процедура ОтправитьОчередьРегламентноеЗадание() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ozs_ОтправкаОчередиВБухгалтерию);

	Итоги = ОбработатьПачку();

	Если Итоги.Выбрано > 0 Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(),
			?(Итоги.Отложено + Итоги.Ошибок > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация),,,
			СтрШаблон("Выбрано: %1, отправлено: %2, отложено: %3, в ошибку: %4%5",
				Итоги.Выбрано, Итоги.Отправлено, Итоги.Отложено, Итоги.Ошибок,
				?(Итоги.СервисНедоступен, " (сервис недоступен, пачка прервана)", "")));
	КонецЕсли;

КонецПроцедуры

// Обработчик регламентного задания ozs_ОчисткаОчередиОбмена (раз в сутки).
// Удаляет успешно отправленные сообщения старше ХранитьОтправленныеДней.
//
Процедура ОчиститьОтправленныеРегламентноеЗадание() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ozs_ОчисткаОчередиОбмена);

	Параметры = ozs_ОбменСБухгалтериейНастройки.Параметры();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ozs_ОчередьОбменаСБухгалтерией КАК Очередь
	|ГДЕ
	|	Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ozs_СтатусыОбмена.Отправлено)
	|	И Очередь.ДатаОтправки < &Граница";
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - Параметры.ХранитьОтправленныеДней * 86400);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ozs_ОчередьОбменаСБухгалтерией.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
		МенеджерЗаписи.Удалить();
	КонецЦикла;

КонецПроцедуры

// Обрабатывает одну пачку сообщений со статусом Ожидает, у которых наступило
// время очередной попытки. Можно вызывать вручную (консоль кода, обработка).
//
// Параметры:
//   РазмерПачки - Число, Неопределено - по умолчанию из настроек (50).
//
// Возвращаемое значение:
//   Структура:
//     * Выбрано          - Число  - сколько сообщений взято в работу.
//     * Отправлено       - Число  - доставлено (2xx).
//     * Отложено         - Число  - отложено на повтор.
//     * Ошибок           - Число  - переведено в статус Ошибка.
//     * СервисНедоступен - Булево - пачка прервана из-за сетевой ошибки.
//
Функция ОбработатьПачку(РазмерПачки = Неопределено) Экспорт

	Итоги = Новый Структура("Выбрано, Отправлено, Отложено, Ошибок, СервисНедоступен", 0, 0, 0, 0, Ложь);

	Параметры = ozs_ОбменСБухгалтериейНастройки.Параметры();
	Сообщения = СообщенияКОтправке(?(РазмерПачки = Неопределено, Параметры.РазмерПачки, РазмерПачки));
	Итоги.Выбрано = Сообщения.Количество();
	Если Итоги.Выбрано = 0 Тогда
		Возврат Итоги;
	КонецЕсли;

	Соединение = НовоеСоединение(Параметры);

	Для Каждого Сообщение Из Сообщения Цикл

		Результат = ОтправитьСообщение(Соединение, Сообщение, Параметры);
		НовыйСтатус = ЗафиксироватьРезультат(Сообщение.Идентификатор, Результат, Параметры);

		Если НовыйСтатус = Перечисления.ozs_СтатусыОбмена.Отправлено Тогда
			Итоги.Отправлено = Итоги.Отправлено + 1;
		ИначеЕсли НовыйСтатус = Перечисления.ozs_СтатусыОбмена.Ошибка Тогда
			Итоги.Ошибок = Итоги.Ошибок + 1;
		Иначе
			Итоги.Отложено = Итоги.Отложено + 1;
		КонецЕсли;

		// Circuit breaker «на минималках»: если сервис не отвечает, нет смысла ждать
		// таймаут на каждом из 50 сообщений. Остальные останутся в очереди нетронутыми,
		// а следующий запуск задания снова «прощупает» сервис одним сообщением.
		Если Результат.ОшибкаСети Тогда
			Итоги.СервисНедоступен = Истина;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Возвращает сообщения из статуса Ошибка обратно в очередь (после исправления причины).
//
// Параметры:
//   Идентификаторы - Массив из УникальныйИдентификатор, Неопределено - что вернуть;
//                    Неопределено = все сообщения в статусе Ошибка.
//
// Возвращаемое значение:
//   Число - количество возвращённых в очередь сообщений.
//
Функция ПереотправитьОшибочные(Идентификаторы = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ozs_ОчередьОбменаСБухгалтерией КАК Очередь
	|ГДЕ
	|	Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ozs_СтатусыОбмена.Ошибка)
	|	И (&ВсеСообщения ИЛИ Очередь.Идентификатор В (&Идентификаторы))";
	Запрос.УстановитьПараметр("ВсеСообщения", Идентификаторы = Неопределено);
	Запрос.УстановитьПараметр("Идентификаторы", ?(Идентификаторы = Неопределено, Новый Массив, Идентификаторы));

	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.ozs_ОчередьОбменаСБухгалтерией.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Статус = Перечисления.ozs_СтатусыОбмена.Ожидает;
			МенеджерЗаписи.КоличествоПопыток = 0;
			МенеджерЗаписи.ДатаСледующейПопытки = ТекущаяДатаСеанса();
			МенеджерЗаписи.Записать();
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

// Количество сообщений в очереди по статусам — для мониторинга и тестов.
//
// Возвращаемое значение:
//   Структура - Ожидает, Отправлено, Ошибка (Число), СамоеСтароеОжидающее (Дата).
//
Функция СостояниеОчереди() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Статус КАК Статус,
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	МИНИМУМ(Очередь.ДатаСоздания) КАК СамоеСтарое
	|ИЗ
	|	РегистрСведений.ozs_ОчередьОбменаСБухгалтерией КАК Очередь
	|
	|СГРУППИРОВАТЬ ПО
	|	Очередь.Статус";

	Состояние = Новый Структура("Ожидает, Отправлено, Ошибка, СамоеСтароеОжидающее", 0, 0, 0, Дата(1, 1, 1));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Статус = Перечисления.ozs_СтатусыОбмена.Ожидает Тогда
			Состояние.Ожидает = Выборка.Количество;
			Состояние.СамоеСтароеОжидающее = Выборка.СамоеСтарое;
		ИначеЕсли Выборка.Статус = Перечисления.ozs_СтатусыОбмена.Отправлено Тогда
			Состояние.Отправлено = Выборка.Количество;
		ИначеЕсли Выборка.Статус = Перечисления.ozs_СтатусыОбмена.Ошибка Тогда
			Состояние.Ошибка = Выборка.Количество;
		КонецЕсли;
	КонецЦикла;

	Возврат Состояние;

КонецФункции

// Задержка перед следующей попыткой: Base * 2^(n-1), не больше Max, плюс джиттер до 20%.
// Джиттер нужен, чтобы после восстановления сети накопленная очередь не ударила
// по сервису синхронной волной (thundering herd).
//
// Параметры:
//   НомерПопытки - Число - номер только что неудавшейся попытки (1, 2, ...).
//   Параметры    - см. ozs_ОбменСБухгалтериейНастройки.Параметры.
//
// Возвращаемое значение:
//   Число - задержка в секундах.
//
Функция ЗадержкаПовтораСек(НомерПопытки, Параметры) Экспорт

	Степень = Мин(НомерПопытки - 1, 20); // защита от переполнения на больших номерах
	Задержка = Мин(Параметры.БазоваяЗадержкаСек * Pow(2, Степень), Параметры.МаксимальнаяЗадержкаСек);
	Задержка = Цел(Задержка);

	ГСЧ = Новый ГенераторСлучайныхЧисел;
	Джиттер = ГСЧ.СлучайноеЧисло(0, Макс(Цел(Задержка / 5), 1));

	Возврат Задержка + Джиттер;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СообщенияКОтправке(РазмерПачки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Очередь.Идентификатор КАК Идентификатор,
	|	Очередь.ТелоJSON КАК ТелоJSON,
	|	Очередь.КоличествоПопыток КАК КоличествоПопыток
	|ИЗ
	|	РегистрСведений.ozs_ОчередьОбменаСБухгалтерией КАК Очередь
	|ГДЕ
	|	Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.ozs_СтатусыОбмена.Ожидает)
	|	И Очередь.ДатаСледующейПопытки <= &ТекущаяДата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.ДатаСоздания,
	|	Очередь.Версия";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 50", "ПЕРВЫЕ " + Формат(РазмерПачки, "ЧГ=0"));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция НовоеСоединение(Параметры)

	ЗащищенноеСоединение = ?(Параметры.ЗащищенноеСоединение, Новый ЗащищенноеСоединениеOpenSSL, Неопределено);

	// Конструктор не открывает сокет — соединение устанавливается при первом запросе,
	// поэтому сетевые ошибки ловятся в ОтправитьСообщение().
	Возврат Новый HTTPСоединение(Параметры.Сервер, Параметры.Порт,,,, Параметры.Таймаут, ЗащищенноеСоединение);

КонецФункции

// Выполняет POST одного сообщения. Никогда не выбрасывает исключение.
//
// Возвращаемое значение:
//   Структура:
//     * Успех        - Булево - получен ответ 2xx.
//     * Повторять    - Булево - ошибка временная, имеет смысл повторить.
//     * ОшибкаСети   - Булево - ответа нет вовсе (нет соединения, таймаут, DNS).
//     * КодСостояния - Число  - HTTP-код ответа (0, если ответа нет).
//     * ТекстОшибки  - Строка - описание ошибки для регистра.
//
Функция ОтправитьСообщение(Соединение, Сообщение, Параметры)

	Результат = Новый Структура("Успех, Повторять, ОшибкаСети, КодСостояния, ТекстОшибки",
		Ложь, Истина, Ложь, 0, "");

	HTTPЗапрос = Новый HTTPЗапрос(Параметры.АдресРесурса);
	HTTPЗапрос.Заголовки.Вставить("Content-Type",    "application/json; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("Accept",          "application/json");
	HTTPЗапрос.Заголовки.Вставить("Idempotency-Key", Строка(Сообщение.Идентификатор));
	HTTPЗапрос.Заголовки.Вставить("X-Ozen-Attempt",  Формат(Сообщение.КоличествоПопыток + 1, "ЧГ=0"));
	Если ЗначениеЗаполнено(Параметры.ТокенДоступа) Тогда
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Параметры.ТокенДоступа);
	КонецЕсли;
	HTTPЗапрос.УстановитьТелоИзСтроки(Сообщение.ТелоJSON, КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		HTTPОтвет = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
	Исключение
		Результат.ОшибкаСети = Истина;
		Результат.ТекстОшибки = "Сервис недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.КодСостояния = HTTPОтвет.КодСостояния;

	Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
		Результат.Успех = Истина;
		Результат.Повторять = Ложь;
		Возврат Результат;
	КонецЕсли;

	ТелоОтвета = "";
	Попытка
		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		ТелоОтвета = "<тело ответа не прочитано>";
	КонецПопытки;

	Результат.Повторять = (HTTPОтвет.КодСостояния <> 400 И HTTPОтвет.КодСостояния <> 422);
	Результат.ТекстОшибки = СтрШаблон("HTTP %1: %2", Формат(HTTPОтвет.КодСостояния, "ЧГ=0"), Лев(ТелоОтвета, 2000));

	Возврат Результат;

КонецФункции

// Записывает результат попытки в регистр под управляемой блокировкой.
// Ошибка записи одного сообщения не прерывает обработку всей пачки.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.ozs_СтатусыОбмена - статус сообщения после записи.
//
Функция ЗафиксироватьРезультат(Идентификатор, Результат, Параметры)

	НовыйСтатус = Перечисления.ozs_СтатусыОбмена.Ожидает;

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ozs_ОчередьОбменаСБухгалтерией");
		ЭлементБлокировки.УстановитьЗначение("Идентификатор", Идентификатор);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		МенеджерЗаписи = РегистрыСведений.ozs_ОчередьОбменаСБухгалтерией.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = Идентификатор;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда

			ТекущаяДата = ТекущаяДатаСеанса();
			МенеджерЗаписи.КоличествоПопыток = МенеджерЗаписи.КоличествоПопыток + 1;
			МенеджерЗаписи.ДатаПоследнейПопытки = ТекущаяДата;
			МенеджерЗаписи.КодОтвета = Результат.КодСостояния;

			Если Результат.Успех Тогда
				МенеджерЗаписи.Статус = Перечисления.ozs_СтатусыОбмена.Отправлено;
				МенеджерЗаписи.ДатаОтправки = ТекущаяДата;
				МенеджерЗаписи.ТекстОшибки = "";

			ИначеЕсли Не Результат.Повторять
				Или (Не Результат.ОшибкаСети И МенеджерЗаписи.КоличествоПопыток >= Параметры.МаксимумПопыток) Тогда
				МенеджерЗаписи.Статус = Перечисления.ozs_СтатусыОбмена.Ошибка;
				МенеджерЗаписи.ТекстОшибки = Результат.ТекстОшибки;

			Иначе
				МенеджерЗаписи.ТекстОшибки = Результат.ТекстОшибки;
				МенеджерЗаписи.ДатаСледующейПопытки = ТекущаяДата
					+ ЗадержкаПовтораСек(МенеджерЗаписи.КоличествоПопыток, Параметры);
			КонецЕсли;

			МенеджерЗаписи.Записать();
			НовыйСтатус = МенеджерЗаписи.Статус;

		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,,,
			СтрШаблон("Не удалось записать результат отправки сообщения %1: %2",
				Идентификатор, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат НовыйСтатус;

КонецФункции

Функция ИмяСобытияЖурнала()
	Возврат "Ozen-Sync.Отправка";
КонецФункции

#КонецОбласти
